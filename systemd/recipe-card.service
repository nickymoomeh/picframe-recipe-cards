[Unit]
Description=Refresh and queue recipe cards for picframe3

[Service]
Type=oneshot
WorkingDirectory=%h/picframe-recipe-cards
ExecStart=%h/picframe-recipe-cards/.venv/bin/recipe-card --config %h/.config/recipe-card/config.toml tick
EnvironmentFile=-%h/.config/recipe-card/environment
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/recipe-card /home/pi4/FrameCards
UMask=0022
TimeoutStartSec=15min
